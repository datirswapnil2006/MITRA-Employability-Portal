# ====================================================
# MITRA Employability Portal - Environment Configuration
# ====================================================

# ----------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------
PORT=5000
NODE_ENV=development

# ----------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------
MONGO_URI=mongodb://localhost:27017/mitra_employability

# ----------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRE=24h

# ----------------------------------------------------
# CORS & FRONTEND URL
# ----------------------------------------------------
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------
# THIRD-PARTY APIS & SERVICES
# ----------------------------------------------------
# Code Execution API Key (Piston / OnlineCompiler Sandbox)
ONLINECOMPILER_API_KEY=your_online_compiler_api_key

# Artificial Intelligence Model Key (HuggingFace Inference API)
HF_TOKEN=your_huggingface_api_token

# ----------------------------------------------------
# EMAIL / SMTP CONFIGURATION (Nodemailer)
# ----------------------------------------------------
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

